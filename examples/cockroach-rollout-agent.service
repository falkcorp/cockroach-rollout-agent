# file: examples/cockroach-rollout-agent.service
# version: 3.2.0
# guid: eaf842e1-7611-4539-848e-73b84ed31c7e

# Replace @CROACH_ROLLOUT_SERVICE@ with this host's CockroachDB unit name.
# It must match CROACH_ROLLOUT_SERVICE in the env file and the polkit rule.
# scripts/install-rollout-agent.sh does the substitution.

[Unit]
Description=CockroachDB Rollout Agent
After=network-online.target @CROACH_ROLLOUT_SERVICE@
Wants=network-online.target

[Service]
Type=simple
User=cockroach
Group=cockroach
EnvironmentFile=/etc/cockroach-rollout-agent.env
# The agent runs from its own layout so it can update itself. Before every
# start, the root-owned copy counts starts of a freshly updated binary and
# restores the previous one if it never settles. `-`: a preflight that
# cannot run must never keep the agent from starting.
ExecStartPre=-/usr/local/bin/cockroach-rollout-agent agent-preflight
ExecStart=/var/lib/cockroach-rollout-agent/agent/bin/cockroach-rollout-agent daemon
Restart=on-failure
RestartSec=10s
# 75: the agent swapped in a new binary and asks to be started on it.
SuccessExitStatus=75
RestartForceExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Every agent write lands here. The CockroachDB unit runs
# /var/lib/cockroach-rollout-agent/bin/cockroach through an ExecStart drop-in;
# /usr/local/bin/cockroach is a separate root-owned copy the agent never touches.
ReadWritePaths=/var/log/cockroach-rollout-agent /var/lib/cockroach-rollout-agent

[Install]
WantedBy=multi-user.target
