# file: examples/cockroach-rollout-agent.env.example
# version: 2.1.0
# guid: 3d948f0d-6c0b-46b0-b9cc-fc7f6cf77a9f

# Host-local configuration for cockroach-rollout-agent.
# Install as /etc/cockroach-rollout-agent.env, 0640 root:cockroach.
# Do not commit real values.

# This host's own node, so status reporting never depends on a peer.
CROACH_ROLLOUT_DATABASE_URL=postgresql://rollout@@NODE_SQL_ADDR@/defaultdb?sslmode=require
CROACH_ROLLOUT_SSL_ROOT_CERT=/etc/cockroach-rollout-agent/certs/ca.crt
CROACH_ROLLOUT_SSL_CLIENT_CERT=/etc/cockroach-rollout-agent/certs/client.rollout.crt
# PKCS#8. Convert with: openssl pkcs8 -topk8 -nocrypt -in client.rollout.key -out client.rollout.pk8
CROACH_ROLLOUT_SSL_CLIENT_KEY=/etc/cockroach-rollout-agent/certs/client.rollout.pk8

# This host's CockroachDB unit. No default: the name differs between hosts.
CROACH_ROLLOUT_SERVICE=@CROACH_ROLLOUT_SERVICE@

CROACH_ROLLOUT_AGENT_ROOT=/var/lib/cockroach-rollout-agent
CROACH_ROLLOUT_ARTIFACTS_DIR=/var/lib/cockroach-rollout-agent/artifacts
CROACH_ROLLOUT_AUDIT_LOG=/var/log/cockroach-rollout-agent/audit.log
CROACH_ROLLOUT_SCHEMA=cockroach_rollout

# Seconds a restarted node may take to rejoin before it is rolled back.
# CROACH_ROLLOUT_RESTART_TIMEOUT_SECONDS=600

# Finalize major-line upgrades without an operator once every node is on
# the new binary. Off by default: finalizing closes the downgrade window.
# CROACH_ROLLOUT_AUTO_FINALIZE=true

# Optional stable ID if hostname is not unique or agents run in containers.
# CROACH_ROLLOUT_NODE_ID=node-1
